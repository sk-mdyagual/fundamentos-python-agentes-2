# -----------------------------------------------------------
# .env.example — Plantilla de variables de entorno
# -----------------------------------------------------------
# Copia este archivo como `.env` en la misma carpeta S6_reto/
# y completa los valores reales. El archivo `.env` NO se
# versiona (está en .gitignore).
# -----------------------------------------------------------

# Clave secreta de la Agencia. Usada para proteger endpoints de escritura.
# Envíala en el header X-API-KEY de cada petición protegida.
AGENCIA_API_KEY=clave-secreta-aqui

# URL de la API externa que alimenta el endpoint GET /briefing/{nombre}.
# Por defecto usa adviceslip.com (gratuita, sin autenticación).
EXTERNAL_API_URL=https://api.adviceslip.com/advice
