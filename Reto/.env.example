# .env.example — Variables de entorno requeridas por la Agencia
# Copia este archivo como .env y rellena los valores reales.
# NUNCA versiones el archivo .env con valores reales.

# Clave de autenticación para los endpoints protegidos (POST /misiones/, etc.)
AGENCIA_API_KEY=tu_clave_secreta_aqui

# URL de la API externa usada en GET /briefing/{nombre}
# Por defecto: https://api.adviceslip.com/advice (no requiere autenticación)
EXTERNAL_API_URL=https://api.adviceslip.com/advice
