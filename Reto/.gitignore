# ===================================================================
# .gitignore — Archivos que NO deben versionarse en Git
# ===================================================================

# Variables de entorno (contienen secretos)
.env

# Base de datos local (contiene datos de desarrollo)
*.db
*.sqlite
*.sqlite3

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Jupyter Notebooks
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
